# Version control / CI
.git
.github

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/

# Virtual environments
venv/
.venv/
env/
ENV/

# Local secrets / env files -- never bake these into the image
.env
.env.*
!.env.example

# Local runtime data (uploads, generated .mat scratch files, logs) --
# never bake development-time app data into the image
app_data/
output/
*.log

# Editor / OS cruft
.vscode/
.idea/
.DS_Store

# Docs and reports not needed at runtime
docs/
reports/
README.md

# Test artifacts and stray result files generated by local runs
.vercel
mic_*_sound_source_localization_*.csv
mic_*_sound_source_localization_*.png
experiments/benchmark_log.txt
experiments/results/
results/
