# Copy to .env for local development (never commit the real .env file --
# it's already in .gitignore). None of these are secrets; the app has no
# API keys, tokens, or credentials of any kind.

# Root directory for all runtime-writable data: staged uploads and
# generated .mat scratch files (see src/paths.py). Defaults to
# ./app_data at the repo root if unset -- only set this if you want the
# data directory somewhere else locally. In production (Render), this is
# set to /var/data by render.yaml, not by this file.
APP_DATA_DIR=./app_data

# Set automatically by Render at runtime; only needed here if you want to
# pin a specific port for local `docker run` / `streamlit run` testing.
# PORT=8080
